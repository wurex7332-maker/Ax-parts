# 复制为 .env 后填写。不要把 .env 提交到 git（已在 .gitignore 中）。

# 已解析到本服务器公网 IP 的域名；Caddy 会为它自动申请证书
# 没有域名时可填 localhost 先跑通，但此时只能本机访问、且无法扫码
DOMAIN=parts.example.com

# 必改：随机长串。生成方式：openssl rand -hex 32
JWT_SECRET=please-change-me-to-a-random-64-hex-string

# 必改：种子账号（warehouse/supervisor/purchaser/operator）的初始密码
SEED_PASSWORD=please-change-me

# 时区，影响日志与时间字段展示
TZ=Asia/Shanghai

# 可选：登录令牌有效期（秒），默认 43200（12 小时）
# JWT_TTL_SECONDS=43200
